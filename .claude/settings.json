{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(node scripts/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./*.pem)",
      "Edit(./.github/**)",
      "Edit(./scripts/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./package-lock.json)",
      "Edit(./.nvmrc)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git * commit)",
      "Bash(git * commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(git reset --hard *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-bash.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-gate.sh", "timeout": 300 }] }
    ]
  }
}
